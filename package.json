{
  "name": "enigma-jev",
  "version": "1.0.0",
  "description": "A software Turing–Welchman Bombe that breaks real Enigma traffic, with Jev, a probabilistic analyst, judging what reads as German. Backtested on historical intercepts.",
  "keywords": [
    "enigma",
    "bombe",
    "cryptanalysis",
    "cryptography",
    "turing",
    "bletchley-park",
    "history",
    "bun",
    "typescript"
  ],
  "author": "Andres Godoy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agodoy21/enigma-jev.git"
  },
  "homepage": "https://github.com/agodoy21/enigma-jev#readme",
  "bugs": {
    "url": "https://github.com/agodoy21/enigma-jev/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "web": "bun run src/web/server.ts",
    "build": "bun build ./web/pages/index.html ./web/pages/research.html ./web/pages/jev.html --outdir dist --minify",
    "cli": "bun run src/cli.ts",
    "backtest": "bun run src/cli.ts backtest",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && biome ci . && bun test",
    "analyze:jev": "bun run src/analysis/jev-eval.ts",
    "analyze:stops": "bun run src/analysis/bombe-stops.ts",
    "analyze:judges": ".venv/bin/python analysis/judges.py",
    "reproduce": "bun run scripts/reproduce.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
