# TypeSafe key for Jev. Used by the command line and the backtests; the web page asks for it instead.
TYPESAFE_API_KEY=
# Pinned model revision (the published results use jev-1.13.0).
JEV_MODEL=jev-1.13.0
# Encrypts the web session cookie. Required on a deployment; optional locally.
SESSION_SECRET=
